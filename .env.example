# Supabase project "toneward" (Dashboard -> Project Settings -> API).
# Both values are public: they ship to the browser. Leave them empty to run without accounts.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Google OAuth web client ID (Google Cloud -> Google Auth Platform -> Clients). Public.
# When set, the sign-in screen uses Google's own button, so Google's consent screen names this
# site instead of the Supabase project domain. The site's origin must be listed under the client's
# "Authorized JavaScript origins" (wildcards aren't allowed, so leave it unset on preview deploys:
# they fall back to the Supabase redirect flow).
VITE_GOOGLE_CLIENT_ID=
