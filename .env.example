# Supabase project "toneward" (Dashboard -> Project Settings -> API).
# Both values are public: they ship to the browser. Leave them empty to run without accounts.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Google OAuth web client ID (Google Cloud -> Google Auth Platform -> Clients). Public.
# When set, "Continue with Google" goes straight to Google and back, so Google's screens name this
# site instead of the Supabase project domain. The site's origin (e.g. http://localhost:5173) must
# be listed exactly under the client's "Authorized redirect URIs". Wildcards aren't allowed, so
# leave it unset on preview deploys: they fall back to the Supabase redirect flow.
VITE_GOOGLE_CLIENT_ID=
